{
	"branches": ["main"],
	"plugins": [
		[
			"@semantic-release/commit-analyzer",
			{
				"preset": "conventionalcommits"
			}
		],
		[
			"@semantic-release/release-notes-generator",
			{
				"preset": "conventionalcommits"
			}
		],
		"@semantic-release/changelog",
		[
			"@semantic-release/exec",
			{
				"prepareCmd": "node -e \"const fs = require('fs'); const p = JSON.parse(fs.readFileSync('package.json')); const t = JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json')); t.version = p.version; fs.writeFileSync('src-tauri/tauri.conf.json', JSON.stringify(t, null, '\t') + '\\n');\""
			}
		],
		[
			"@semantic-release/git",
			{
				"assets": ["package.json", "src-tauri/tauri.conf.json", "CHANGELOG.md"],
				"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
			}
		],
		[
			"@semantic-release/github",
			{
				"assets": [
					{
						"path": "artifacts/windows-bundle-x64/*.exe",
						"label": "Windows (x64)"
					},
					{
						"path": "artifacts/windows-bundle-arm64/*.exe",
						"label": "Windows (ARM64)"
					},
					{
						"path": "artifacts/linux-bundle-amd64/**/*.deb",
						"label": "Linux Debian (amd64)"
					},
					{
						"path": "artifacts/linux-bundle-arm64/**/*.deb",
						"label": "Linux Debian (arm64)"
					},
					{
						"path": "artifacts/linux-bundle-amd64/**/*.rpm",
						"label": "Linux RPM (amd64)"
					},
					{
						"path": "artifacts/linux-bundle-arm64/**/*.rpm",
						"label": "Linux RPM (arm64)"
					},
					{
						"path": "artifacts/linux-bundle-amd64/**/*.AppImage",
						"label": "Linux AppImage (amd64)"
					},
					{
						"path": "artifacts/linux-bundle-arm64/**/*.AppImage",
						"label": "Linux AppImage (arm64)"
					}
				]
			}
		]
	]
}
