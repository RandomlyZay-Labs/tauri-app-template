# This is an example environment file.
# 1. Copy this file to a new file named `.env` in the same directory (`src-tauri/`).
# 2. For SQLx CLI, ensure DATABASE_URL is set correctly.
# 3. The `.env` file is ignored by git and will not be committed.

# --- SQLx CLI ---
# This path is relative to the `src-tauri` directory.
# We point to the `dev_data` folder in the project root to share the DB with the running app.
DATABASE_URL="sqlite:../dev_data/tauri_app_template.db"