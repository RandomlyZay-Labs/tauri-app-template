{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Tauri App Template",
	"mainBinaryName": "tauri-app-template",
	"version": "0.12.3",
	"identifier": "io.github.randomlyzay-labs.tauri-app-template",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.github.com https://translate.googleapis.com; img-src 'self' asset: https://asset.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["rpm", "deb", "appimage", "nsis", "app"],
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {}
		},
		"linux": {
			"deb": {
				"files": {
					"/etc/apt/sources.list.d/tauri-app-template.list": "resources/tauri-app-template.list",
					"/etc/apt/keyrings/tauri-app-template.gpg": "resources/tauri-app-template.gpg"
				}
			},
			"rpm": {
				"files": {
					"/etc/yum.repos.d/_copr:copr.fedorainfracloud.org:randomlyzay:tauri-app-template.repo": "resources/tauri-app-template.repo"
				}
			}
		}
	},
	"plugins": {
		"updater": {
			"endpoints": [
				"https://github.com/RandomlyZay-Labs/tauri-app-template/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3NjVBMTYzNDg0MTQ0REYKUldUZlJFRklZNkZsWjBFZ1hZYTZ5TmREV3A0YkRnVTRJckIrZDdEeTloa0dtc3Bkb3dQMDczckEK"
		}
	}
}
