{
	"name": "tauri-app-template",
	"private": true,
	"version": "0.6.2",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/RandomlyZay-Labs/tauri-app-template.git"
	},
	"scripts": {
		"bootstrap": "pnpm dlx shx mkdir -p dev_data && cd src-tauri && pnpm dlx shx cp -n .env.example .env && (sqlx database create || true) && sqlx migrate run && cd ..",
		"verify": "node scripts/verify.js",
		"verify:frontend": "run-s check:frontend test:frontend",
		"verify:backend": "run-s check:backend test:backend",
		"check": "run-s check:backend check:frontend",
		"check:frontend": "run-s gen:bindings check:ts check:biome knip",
		"gen:bindings": "cd src-tauri && TAURI_GEN_BINDINGS_ONLY=1 cargo run",
		"check:ts": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:biome": "biome check --write --error-on-warnings",
		"check:backend": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
		"test": "run-s test:backend test:frontend",
		"test:vitest": "vitest run",
		"test:frontend": "run-s test:vitest test:e2e",
		"test:watch": "vitest",
		"test:backend": "cd src-tauri && cargo test --no-fail-fast",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"dev": "vite",
		"cli": "cd src-tauri && cross-env TAURI_APP_TEMPLATE_DATA_DIR=dev_data cargo run --bin tauri-app-template-cli --",
		"build": "vite build",
		"build:prod": "pnpm build && pnpm prune --prod --ignore-scripts",
		"knip": "knip --treat-config-hints-as-errors",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:dev": "cross-env TAURI_APP_TEMPLATE_DATA_DIR=dev_data tauri dev",
		"prepare": "husky",
		"db:prepare": "cd src-tauri && cargo sqlx prepare -- --lib",
		"release": "semantic-release"
	},
	"dependencies": {
		"@tauri-apps/cli": "^2.11.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.16.0",
		"@playwright/test": "^1.60.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.8",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-log": "^2.8.0",
		"@tauri-apps/plugin-notification": "^2.3.3",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-store": "^2.4.3",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^25.8.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"cross-env": "^10.1.0",
		"date-fns": "^4.1.0",
		"happy-dom": "^20.9.0",
		"husky": "^9.1.7",
		"i18next": "^26.2.0",
		"knip": "^6.14.1",
		"npm-run-all": "^4.1.5",
		"semantic-release": "^25.0.3",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.8",
		"svelte-sonner": "^1.1.1",
		"svelte-spa-router": "^5.1.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.13",
		"vitest": "^4.1.6"
	}
}
